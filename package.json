{
  "name": "aprovest-tcc",
  "private": true,
  "version": "1.0.0",
  "description": "AproVest TCC - preparação para vestibulares (Curso Técnico em Informática - FIEB/ITB, INF2CM)",
  "type": "module",
  "scripts": {
    "postinstall": "cd aprovest-web && npm install --no-audit --no-fund",
